# ---------------------------------------------------------------------------
# Novus MFB — environment variables (example)
#
# Copy this file to the appropriate .env file and fill in real values locally.
# NEVER commit real secrets. Only safe placeholders belong in this file.
# ---------------------------------------------------------------------------

# --- General -----------------------------------------------------------------
NODE_ENV=development
API_PORT=4000

# Public app URLs (used by the web app; NEXT_PUBLIC_* are exposed to the browser)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_URL=http://localhost:4000/api/v1

# Comma-separated list of origins allowed to call the API with credentials
ALLOWED_ORIGINS=http://localhost:3000

# --- Database ----------------------------------------------------------------
# Matches the docker-compose.yml service. Change for your own Postgres.
DATABASE_URL=postgresql://novus:novus_dev_password@localhost:5432/novus_dev?schema=public
# Used by automated tests
TEST_DATABASE_URL=postgresql://novus:novus_dev_password@localhost:5432/novus_test?schema=public

# --- Cache / queues (optional) ----------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Authentication ----------------------------------------------------------
# Generate a strong value, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
SESSION_TTL_HOURS=24

# --- AI provider (Nova chatbot) ---------------------------------------------
# Leave AI_PROVIDER_API_KEY empty to run Nova in clearly-labelled demo mode.
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=gpt-4o-mini
# Optional: point at any OpenAI-compatible gateway, e.g. OpenRouter:
#   AI_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
#   AI_PROVIDER_MODEL=deepseek/deepseek-chat-v3-0324
AI_PROVIDER_BASE_URL=

# --- Email provider (verification, notifications) ---------------------------
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=no-reply@novusmfb.com

# --- SMS provider (OTP, optional) -------------------------------------------
SMS_PROVIDER_API_KEY=

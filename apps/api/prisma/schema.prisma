// Prisma schema for Novus MFB.
//
// Banking-related entities beyond portal/support/AI concerns are intentionally
// omitted until real product requirements and integration boundaries are approved
// (Phase 7). UUIDs are used for all primary keys.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SUPPORT_AGENT
  ADMIN
  SUPER_ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  ESCALATED
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ConversationStatus {
  ACTIVE
  ESCALATED
  AGENT_JOINED
  CLOSED
}

enum MessageSender {
  CUSTOMER
  NOVA
  AGENT
  SYSTEM
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  phone             String?   @unique
  passwordHash      String?
  role              Role      @default(CUSTOMER)
  firstName         String
  lastName          String
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  customerProfile   CustomerProfile?
  sessions          Session[]
  emailTokens       VerificationToken[]
  passwordResets    PasswordResetToken[]
  ticketsCreated    Ticket[]             @relation("TicketCustomer")
  ticketsAssigned   Ticket[]             @relation("TicketAgent")
  ticketMessages    TicketMessage[]
  conversations     Conversation[]
  notifications     Notification[]
  auditEvents       AuditEvent[]
  feedback          ChatbotFeedback[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model CustomerProfile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @db.Uuid
  dateOfBirth   DateTime?
  address       String?
  city          String?
  state         String?
  bvn           String?  // stored only if/when legally approved; never seeded with real data
  preferredLanguage String @default("en")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model Session {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  tokenHash      String   @unique
  userAgent      String?
  ipAddress      String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  type      String   // e.g. EMAIL_VERIFY, PHONE_VERIFY
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Ticket {
  id          String         @id @default(uuid()) @db.Uuid
  reference   String         @unique
  customerId  String         @db.Uuid
  assigneeId  String?        @db.Uuid
  category    String
  subject     String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(NORMAL)
  resolution  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  closedAt    DateTime?

  customer  User            @relation("TicketCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  assignee  User?           @relation("TicketAgent", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages  TicketMessage[]
  events    TicketEvent[]

  @@index([customerId])
  @@index([assigneeId])
  @@index([status])
  @@map("tickets")
}

model TicketMessage {
  id         String        @id @default(uuid()) @db.Uuid
  ticketId   String        @db.Uuid
  authorId   String        @db.Uuid
  body       String
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@map("ticket_messages")
}

model TicketEvent {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @db.Uuid
  actorId   String?  @db.Uuid
  type      String   // STATUS_CHANGE, ASSIGNMENT, PRIORITY_CHANGE, etc.
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_events")
}

model Conversation {
  id            String             @id @default(uuid()) @db.Uuid
  customerId    String?            @db.Uuid
  agentId       String?            @db.Uuid
  ticketId      String?            @db.Uuid
  status        ConversationStatus @default(ACTIVE)
  language      String             @default("en")
  summary       String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  closedAt      DateTime?

  customer  User?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages  ConversationMessage[]
  feedback  ChatbotFeedback[]

  @@index([customerId])
  @@index([status])
  @@map("conversations")
}

model ConversationMessage {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  sender         MessageSender
  content        String
  language       String?
  isInternal     Boolean       @default(false)
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("conversation_messages")
}

model ChatbotFeedback {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  userId         String?  @db.Uuid
  rating         Int      // 1-5
  comment        String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@map("chatbot_feedback")
}

model KnowledgeArticle {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  title       String
  category    String
  content     String
  keywords    String[]
  language    String   @default("en")
  version     Int      @default(1)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions KnowledgeArticleVersion[]

  @@index([category])
  @@index([isPublished])
  @@map("knowledge_articles")
}

model KnowledgeArticleVersion {
  id          String   @id @default(uuid()) @db.Uuid
  articleId   String   @db.Uuid
  version     Int
  title       String
  content     String
  createdAt   DateTime @default(now())

  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, version])
  @@map("knowledge_article_versions")
}

model Notification {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @db.Uuid
  channel   NotificationChannel
  status    NotificationStatus   @default(PENDING)
  title     String
  body      String
  metadata  Json?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("notifications")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_events")
}
